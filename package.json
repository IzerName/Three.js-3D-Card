{
  "name": "threejs-3d-card",
  "version": "0.1.0",
  "private": true,
  "description": "Home Assistant Lovelace card: 3D scenes (three.js) driven by pluggable models with auto-generated config editor",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --no-minify",
    "watch": "node scripts/build.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "demo": "node scripts/build.mjs && node scripts/serve.mjs --open",
    "test": "node test/run.mjs",
    "check": "node scripts/build.mjs && node test/run.mjs"
  },
  "devDependencies": {
    "terser": "^5.51.2",
    "three": "0.160.1"
  }
}
