# Демонстрационная комната для threejs-3d-card (skills/threejs-3d-model/examples)
# Единицы — метры, Y — вверх. Каждая управляемая деталь — отдельная группа "o <Имя>".
# Имена совпадают с room.json: Lamp_Ceiling, Door_Front, Fan_Bathroom, Label_Temp, Floor.
#
# ВАЖНО (частая ошибка при генерации OBJ):
#   1) индексы вершин в "f" — СКВОЗНЫЕ по всему файлу, а не с единицы в каждом
#      объекте. Если начать каждый объект с 1, все объекты получат геометрию
#      первого (в лучшем случае — «всё схлопнется в одну деталь»);
#   2) строка "mtllib" в начале и "usemtl <Имя>" перед гранями каждого объекта
#      обязательны: без них загрузчик создаст белый материал по умолчанию и
#      смена цвета по состоянию будет выглядеть как «белое → белое».

mtllib room.mtl

o Floor
usemtl Floor
v -3 0 -3
v 3 0 -3
v 3 0 3
v -3 0 3
f 1 2 3
f 1 3 4

o Lamp_Ceiling
usemtl Lamp_Ceiling
v -0.3 2.45 -0.3
v 0.3 2.45 -0.3
v 0.3 2.45 0.3
v -0.3 2.45 0.3
v -0.3 2.6 -0.3
v 0.3 2.6 -0.3
v 0.3 2.6 0.3
v -0.3 2.6 0.3
f 5 6 7
f 5 7 8
f 9 10 11
f 9 11 12
f 5 6 10
f 5 10 9
f 6 7 11
f 6 11 10
f 7 8 12
f 7 12 11
f 8 5 9
f 8 9 12

o Door_Front
usemtl Door_Front
v 2.0 0 -2.95
v 2.9 0 -2.95
v 2.9 2.05 -2.95
v 2.0 2.05 -2.95
f 13 14 15
f 13 15 16

o Fan_Bathroom
usemtl Fan_Bathroom
v -2.4 1.7 -2.9
v -1.8 1.7 -2.9
v -1.8 2.3 -2.9
v -2.4 2.3 -2.9
v -2.1 2.0 -2.85
f 17 18 19
f 17 19 20
f 17 18 21
f 18 19 21
f 19 20 21
f 20 17 21

o Sensor_Panel
usemtl Sensor_Panel
v -2.95 1.1 0.5
v -2.95 1.35 0.5
v -2.95 1.35 0.9
v -2.95 1.1 0.9
f 22 23 24
f 22 24 25

o Label_Temp
usemtl Label_Temp
v -0.4 2.05 0.9
v 0.4 2.05 0.9
v 0.4 2.35 0.9
v -0.4 2.35 0.9
f 26 27 28
f 26 28 29
